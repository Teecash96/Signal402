{
  "name": "signal402",
  "version": "1.0.0",
  "description": "A free agent-to-agent market-intelligence service on Binance Agent OS: MCP, CLI, and HTTP agents can read explainable Binance Spot and Futures briefings and request human-approved, risk-gated trading through runtime discovered Binance MCP tools. Optional Binance x402 settlement is supported.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:seller": "npx tsx src/seller/index.ts",
    "start:buyer": "npx tsx src/buyer/index.ts",
    "start:signal402-agent": "npx tsx src/agent/server.ts",
    "hash:dashboard-password": "node scripts/hash-dashboard-password.mjs",
    "validate:judge": "node scripts/judge-validation.mjs",
    "dev:seller": "npx tsx watch src/seller/index.ts",
    "dev:buyer": "npx tsx watch src/buyer/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "binance",
    "agent-os",
    "x402",
    "mcp",
    "trading",
    "ai-agents"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.1",
    "@x402/core": "^2.24.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "typescript": "^5.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "tsx": "^4.23.13"
  }
}
