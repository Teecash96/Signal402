# Binance Agentic MCP
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
MCP_CALLBACK_PORT=8765
MCP_CLIENT_METADATA_URL=https://raw.githubusercontent.com/Teecash96/Signal402/main/client-metadata.json
MCP_TOKEN_FILE=.mcp-tokens.json

# Seller and buyer
SELLER_PORT=3001
SELLER_ENDPOINT_URL=http://localhost:3001
PUBLIC_SELLER_URL=http://localhost:3001
TRADE_SYMBOL=BNBUSDT
MAX_TRADE_SIZE_USDT=10
APPROVAL_TIMEOUT_MS=300000
APPROVAL_POLL_MS=1000
ALLOW_PUBLIC_REST_FALLBACK=false

# Binance B402 merchant credentials. Get these through Binance partner onboarding.
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY_BASE64=
B402_PAY_TO=
B402_NETWORK=eip155:56
B402_USDC_ASSET=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
B402_USDC_DECIMALS=6
B402_MAX_TIMEOUT_SECONDS=300
REPORT_PRICE_USDC=0.01

# Binance Agentic Wallet
BINANCE_AGENTIC_WALLET_BIN=baw
# Leave false to require the terminal prompt. Set true only after a human approved this exact payment.
CONFIRM_X402_PAYMENT=false
